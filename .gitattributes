# Source, tests and golden snapshots are compared byte-for-byte: always LF, never converted on checkout (Windows CI).
* text=auto eol=lf
# Third-party artifacts, fixtures and samples keep their original bytes (provenance hashes, MANIFEST.json).
packages/rules/artifacts/** -text
fixtures/** -text
packages/*/fixtures/** -text
packages/server/samples/** -text
*.pdf binary
*.png binary
*.gif binary
*.mp4 binary
*.jar binary
*.gz binary
*.zip binary

packages/rules/pdf/*.ttf binary
packages/rules/pdf/*.icc binary

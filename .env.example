# Required in HTTP mode (>= 16 characters). Generate one: openssl rand -hex 24
KONTOR_AUTH_TOKEN=
# Optional: extra browser origins (comma-separated) besides localhost
#KONTOR_ALLOWED_ORIGINS=https://agent.example
# Optional: extra Host header values when behind a reverse proxy (loopback names always pass)
#KONTOR_ALLOWED_HOSTS=kontor.internal
# Optional: file-size / JSON-body cap in MB (default 20)
#KONTOR_MAX_FILE_MB=20

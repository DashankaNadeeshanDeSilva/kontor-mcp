{
  "name": "@kontor-mcp/client",
  "version": "1.0.1",
  "description": "kontor-agent — reference MCP client CLI: introspection, one-shot audit, and an Anthropic agent loop over Kontor MCP (stdio or Streamable HTTP)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp#readme",
  "bugs": {
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp/issues"
  },
  "keywords": [
    "e-invoice",
    "xrechnung",
    "zugferd",
    "factur-x",
    "en16931",
    "mcp",
    "model-context-protocol",
    "invoice-validation",
    "germany",
    "mcp-client",
    "cli",
    "anthropic"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kontor-agent": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@kontor-mcp/core": "workspace:*",
    "@kontor-mcp/server": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0"
  }
}

{
  "name": "@kontor-mcp/core",
  "version": "1.0.4",
  "description": "Kontor MCP — MCP-free core library: detect, parse, validate, generate, convert EN 16931 e-invoices (XRechnung, ZUGFeRD)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp#readme",
  "bugs": {
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp/issues"
  },
  "keywords": [
    "e-invoice",
    "xrechnung",
    "zugferd",
    "factur-x",
    "en16931",
    "mcp",
    "model-context-protocol",
    "invoice-validation",
    "germany",
    "pdf-a-3",
    "ubl",
    "cii"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kontor-mcp/rules": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.12",
    "decimal.js": "10.6.0",
    "ibantools": "4.5.4",
    "pdf-lib": "1.17.1",
    "saxon-js": "2.7.0",
    "xmllint-wasm": "5.3.0",
    "xpath": "0.0.34",
    "zod": "4.4.3"
  }
}

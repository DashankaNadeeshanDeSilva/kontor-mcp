{
  "name": "@kontor-mcp/server",
  "version": "1.0.4",
  "description": "Kontor MCP server — sovereign e-invoice tools for AI agents over stdio and Streamable HTTP",
  "mcpName": "io.github.DashankaNadeeshanDeSilva/kontor-mcp",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp#readme",
  "bugs": {
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp/issues"
  },
  "keywords": [
    "e-invoice",
    "xrechnung",
    "zugferd",
    "factur-x",
    "en16931",
    "mcp",
    "model-context-protocol",
    "invoice-validation",
    "germany",
    "mcp-server",
    "claude"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kontor-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "samples",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@kontor-mcp/core": "workspace:*",
    "@kontor-mcp/rules": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}

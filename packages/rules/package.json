{
  "name": "@kontor-mcp/rules",
  "version": "0.1.0",
  "description": "Kontor MCP \u2014 bundled standards artifacts (XSDs, compiled Schematron, codelists) and rule knowledge base",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "artifacts",
    "kb",
    "legal",
    "codelists",
    "README.md"
  ],
  "scripts": {
    "codelists:build": "tsx ../../tools/build-codelists.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}

{
  "name": "@kontor-mcp/rules",
  "version": "1.0.0",
  "description": "Kontor MCP — bundled standards artifacts (XSDs, compiled Schematron, codelists) and rule knowledge base",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp.git",
    "directory": "packages/rules"
  },
  "homepage": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp#readme",
  "bugs": {
    "url": "https://github.com/DashankaNadeeshanDeSilva/kontor-mcp/issues"
  },
  "keywords": [
    "e-invoice",
    "xrechnung",
    "zugferd",
    "factur-x",
    "en16931",
    "mcp",
    "model-context-protocol",
    "invoice-validation",
    "germany"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "artifacts",
    "kb",
    "legal",
    "pdf",
    "codelists",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "codelists:build": "tsx ../../tools/build-codelists.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}

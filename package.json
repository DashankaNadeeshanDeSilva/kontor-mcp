{
  "name": "kontor-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Kontor MCP \u2014 the sovereign e-invoice toolkit for AI agents. Official XRechnung/EN 16931 validation, ZUGFeRD in and out, 100% offline, zero API keys.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "artifacts": "tsx tools/fetch-artifacts.ts",
    "spike:sef": "sh tools/compile-sef.sh",
    "rules:build": "tsx tools/build-rules-artifacts.ts",
    "bt-coverage": "tsx tools/bt-coverage.ts",
    "oracle": "tsx tools/oracle.ts",
    "verapdf": "sh tools/verapdf.sh",
    "spike:pdfa3": "tsx tools/spike-pdfa3.ts",
    "mustang": "sh tools/mustang.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^22.0.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "saxon-js": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "xslt3": "^2.7.0"
  }
}
